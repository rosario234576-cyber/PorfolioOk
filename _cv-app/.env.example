# Copiá este archivo como .env y completá los valores.

# Gemini (gratis con límites): creá la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo principal y respaldos (cada uno tiene su propio cupo gratis diario)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Claude (opcional, pago): se usa solo si NO hay GEMINI_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# Clave para entrar a la app. Si la dejás vacía, la app queda abierta (útil solo en tu compu).
ACCESS_CODE=

# Claves para tus amigos: una por persona, "Nombre:clave" separadas por comas.
# Para sacarle el acceso a alguien, borrá su clave y reiniciá la app.
# ACCESS_CODES=Juan:mate-azul-77, Sofi:luna-verde-12
ACCESS_CODES=

PORT=3000
